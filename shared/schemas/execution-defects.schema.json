{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA-AI Execution Defect Links",
  "type": "object",
  "required": ["schema_version", "execution_id", "defects"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "execution_id": {"type": "string", "pattern": "^RUN-[A-Za-z0-9-]+$"},
    "defects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["defect_id", "title", "source_execution_result_ids"],
        "properties": {
          "defect_id": {"type": "string", "pattern": "^BUG-[A-Za-z0-9-]+$"},
          "external_id": {"type": ["string", "null"]},
          "title": {"type": "string", "minLength": 1},
          "source_execution_result_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ER-[0-9]{4,}$"}},
          "status": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
