{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-ai/test-case-export.schema.json",
  "title": "QA-AI Test Case Export Model",
  "type": "object",
  "required": ["schema_version", "artifact_type", "source_path", "source_checksum", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "test-cases"},
    "source_path": {"type": "string", "minLength": 1},
    "source_checksum": {"type": "string", "minLength": 64},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_case_id", "module_function", "scenario_id", "title", "preconditions_setup", "steps", "test_data", "expected_result", "priority", "traceability"],
        "properties": {
          "test_case_id": {"type": "string", "pattern": "^TC-"},
          "module_function": {"type": "string"},
          "scenario_id": {"type": "string"},
          "title": {"type": "string"},
          "preconditions_setup": {"type": "string"},
          "steps": {"type": "array", "items": {"type": "string"}},
          "test_data": {"type": "string"},
          "expected_result": {"type": "string"},
          "priority": {"type": "string"},
          "traceability": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
