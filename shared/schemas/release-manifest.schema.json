{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA-AI Release Manifest",
  "type": "object",
  "required": ["schema_version", "release_id", "version", "status", "repository_revision", "generated_at", "capabilities", "validation_requirements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "release_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["Draft", "Candidate", "Validated", "Released", "Superseded"]},
    "repository_revision": {"type": "string", "minLength": 7},
    "generated_at": {"type": "string", "minLength": 1},
    "capabilities": {"type": "object"},
    "validation_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}}
  }
}
