{
  "schema_version": "1.0",
  "title": "QA-AI Workspace Revision Metadata",
  "required_fields": [
    "schema_version",
    "project_id",
    "feature_id",
    "revision_id",
    "snapshot_at",
    "framework_revision",
    "sources",
    "artifacts"
  ],
  "identity_patterns": {
    "revision": "REV-###",
    "source": "SRC-###"
  },
  "artifact_status_values": ["Draft", "Review", "Approved", "Superseded", "Archived"],
  "freshness_values": ["Current", "Stale", "Unknown"]
}
