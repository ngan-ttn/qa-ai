{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qa-ai/regression-export.schema.json",
  "title": "QA-AI Regression Export Model",
  "type": "object",
  "required": ["schema_version", "artifact_type", "source_path", "source_checksum", "impact_records", "tiers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "regression-analysis"},
    "source_path": {"type": "string"},
    "source_checksum": {"type": "string"},
    "impact_records": {"type": "array", "items": {"type": "object"}},
    "tiers": {
      "type": "object",
      "required": ["minimum_release_gate", "recommended", "full_changed_feature"],
      "properties": {
        "minimum_release_gate": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "recommended": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "full_changed_feature": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
